# Copy to .env (docker compose reads it automatically). Everything is optional; the monitor runs keyless.
OLLAMA_MODEL=qwen3.5:4b
BRIEF_HOURS=06,12,18,00
# Cloudflare Radar (free): dash.cloudflare.com -> API Tokens -> custom token, permission Account / Radar / Read.
# Enables the Cloudflare outage layer, top attack-origin countries and BGP hijack items.
CLOUDFLARE_API_TOKEN=
# NVD (free, nvd.nist.gov/developers/request-an-api-key): only raises the CVE rate limit.
NVD_API_KEY=
# abuse.ch Auth-Key (free, auth.abuse.ch): enables ThreatFox IOC statistics.
ABUSECH_AUTH_KEY=
# OpenCTI (optional): URL of an OpenCTI instance you have access to and an API token
# (OpenCTI -> profile -> API access). Pulls recent reports into the feed, plus indicators
# and intrusion sets into the OpenCTI panel and the brief. Do NOT run OpenCTI on this box:
# it needs Elastic/OpenSearch + RabbitMQ + MinIO + Redis, ~8-16 GB RAM on its own.
OPENCTI_URL=
OPENCTI_TOKEN=
