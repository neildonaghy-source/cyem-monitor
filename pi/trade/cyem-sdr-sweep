#!/bin/bash
# One CyEM spectrum sweep on trade's RTL-SDR, which the Ecowitt weather receiver normally holds.
# Stops ecowitt-receiver, runs one rtl_power pass (24-1766 MHz, about 2 minutes), posts it to CyEM, and always
# restarts ecowitt-receiver, even on failure. Exits 0 quietly while live listening (cyem-sdr-mode) holds the lock.
# Run by cyem-sdr-sweep.timer a few times a day (Neil, 19 Nov 2026).
set -uo pipefail
exec 9>/run/cyem-sdr-sweep.lock
flock -n 9 || exit 0                                # a sweep or live listening holds the dongle: skip this one
restore() { systemctl start ecowitt-receiver.service; }
trap restore EXIT
systemctl stop ecowitt-receiver.service
sleep 3                                              # let rtl_433 release the dongle
set -a; . /etc/cyem-sweep.env; set +a
timeout 600 /usr/bin/python3 -I -B /opt/cyem-sweep/cyem_sweep.py --once
rc=$?
echo "sweep exit $rc"
exit $rc
